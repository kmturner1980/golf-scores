/** Reuses a year with this exact label if one exists; otherwise creates it (and makes it current). */
function findOrCreateSeedYear_(label) {
  var existing = listYears_().filter(function (y) { return y.Label === label; })[0];
  if (existing) return existing.YearID;
  return createYear_(label).yearId;
}

/** Reuses a player with this exact name if one exists; otherwise creates them as Boy and rosters them for yearId. */
function findOrCreateSeedPlayer_(name, yearId) {
  var existing = listPlayers_().filter(function (p) {
    return (p.Name || '').toString().trim().toLowerCase() === name.toLowerCase();
  })[0];
  if (existing) {
    addPlayerToYear_(existing.Token, yearId);
    return existing.Token;
  }
  return addPlayer_(name, 'Boy', yearId).Token;
}
